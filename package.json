{
  "name": "social-graph",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving personal social graph and Social Health Score (CSM500 project).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "android": "npm run android -w @sg/mobile",
    "sensitivity": "vite-node packages/synth/scripts/sensitivity.ts > docs/evaluation/score-sensitivity.md"
  },
  "devDependencies": {
    "fast-check": "^3.22.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
